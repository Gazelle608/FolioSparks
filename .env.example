# ===========================================================================
# FolioSparks — environment template
#
# Copy this file to `.env` (same folder, next to vite.config.ts) and fill in
# your values:   cp .env.example .env
#
# This is the ONLY env file in the project. Vite loads it from the project
# root because that's where vite.config.ts is. All variables MUST be prefixed
# with VITE_ to be visible in the app.
# Restart `npm run dev` after changing .env.
# ===========================================================================

# ---------- Supabase (REQUIRED) ---------------------------------------------
# Project Settings -> API. The app will throw on startup without these two.
# Used by: src/api/supabase.ts (auth, database, storage)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# ---------- API backend (OPTIONAL) ------------------------------------------
# Only needed if you deploy an API for audio streaming/generation and Stripe
# checkout (src/api/backend.ts). Leave as-is for local development;
# those few features fail gracefully without a server.
VITE_API_URL=http://localhost:4000